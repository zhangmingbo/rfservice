<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_LEVEL" value="INFO"/>
    <property name="LOG_PATH" value="log"/>
    <property name="LOG_FILE" value="rfservice.log"/>
    <property name="LOG_HISTORY" value="rfservice.%d{yyyy-MM-dd}.zip"/>

    <!--日志输出到控制台-->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--日志输出到文件-->
    <springProfile name="!dev">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_PATH}/${LOG_FILE}</file>
            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${LOG_PATH}/${LOG_HISTORY}</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
        </appender>
    </springProfile>

    <!--异步到文件-->
    <springProfile name="!dev">
        <appender name="asyncFileAppender" class="ch.qos.logback.classic.AsyncAppender">
            <discardingThreshold>0</discardingThreshold>
            <queueSize>500</queueSize>
            <appender-ref ref="FILE"/>
        </appender>
    </springProfile>


    <!--开发环境:打印控制台-->
    <springProfile name="dev">
        <!-- 打印sql -->
        <logger name="cn.mrusg.project" level="DEBUG"/>
        <!-- 设置SunEcmClient相关日志级别为WARN -->
        <logger name="com.sunyard.client" level="WARN"/>
        <logger name="com.sunyard.client.conn" level="WARN"/>
        <logger name="com.sunyard.client.impl" level="WARN"/>
        <logger name="com.sunyard.ws.utils.XMLUtil" level="WARN"/>
        <root level="${LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 输出格式 appender -->
    <springProfile name="!dev">
        <!-- 设置SunEcmClient相关日志级别为WARN -->
        <logger name="com.sunyard.client" level="WARN"/>
        <logger name="com.sunyard.client.conn" level="WARN"/>
        <logger name="com.sunyard.client.impl" level="WARN"/>
        <logger name="com.sunyard.ws.utils.XMLUtil" level="WARN"/>
        <root level="${LOG_LEVEL}">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="asyncFileAppender"/>
        </root>
    </springProfile>


</configuration>